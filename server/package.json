{
  "name": "@prepant/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && node esbuild.config.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/index.ts",
    "seed:reset": "tsx src/seed/index.ts --reset",
    "seed:users": "tsx src/seed/users.ts",
    "seed:taxonomy": "tsx src/seed/taxonomy.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.9.0",
    "zod": "^3.24.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "luxon": "^3.5.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.0",
    "node-cron": "^3.0.3",
    "socket.io": "^4.8.0",
    "razorpay": "^2.9.0",
    "google-auth-library": "^9.15.0",
    "cloudinary": "^2.5.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.24.0",
    "vitest": "^2.1.0",
    "supertest": "^7.0.0",
    "mongodb-memory-server": "^10.4.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.17",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "@types/supertest": "^6.0.2",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "@eslint/js": "^9.16.0",
    "typescript-eslint": "^8.17.0",
    "globals": "^15.13.0"
  }
}
